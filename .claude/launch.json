{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@stencil/api", "dev:memory"],
      "port": 5000
    },
    {
      "name": "api-atlas",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@stencil/api", "dev"],
      "port": 5000
    },
    {
      "name": "web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@stencil/web", "dev"],
      "port": 5173
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@stencil/mobile", "exec", "node", "node_modules/expo/bin/cli", "start", "--go", "--web", "--port", "8081"],
      "port": 8081
    }
  ]
}
