# Template for /var/www/stencil-hrms/apps/api/.env on the VPS (never commit the real file; chmod 600 it).
# Copy every value marked "Railway" exactly from Railway → HRMS → Variables → Raw Editor.

# --- Fixed for this VPS --------------------------------------------------------
NODE_ENV=production
PORT=5060
TRUST_PROXY=true
API_URL=https://hrms.stencilindia.com
# Scheduled jobs (reminders, auto-absent, leave accrual). false while the Railway server still runs, so they
# don't run twice; true once Railway is switched off (then `pm2 restart stencil-hrms-api`).
ENABLE_JOBS=false

# --- From Railway (must be identical) -------------------------------------------
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts bank / ID details already in the database: a different key makes them unreadable.
FIELD_ENCRYPTION_KEY=
CLIENT_URL=
STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=
FIREBASE_SERVICE_ACCOUNT=
# Plus any others Railway has (SMTP_*, EMAIL_FROM, COOKIE_*, EXPO_ACCESS_TOKEN, GITHUB_TOKEN), unchanged.
